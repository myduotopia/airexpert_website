# 複製成 .env.local 並填入實際值（.env.local 已被 gitignore）

# --- 公開（會打包進前端，受 RLS 保護）---
NEXT_PUBLIC_SUPABASE_URL=https://jgqswfjdehtpesfdlmhe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 僅 server 端（切勿加 NEXT_PUBLIC_ 前綴、切勿外流）---
# 後台寫入 / 讀聯絡來信用，繞過 RLS
SUPABASE_SERVICE_ROLE_KEY=
# 機密欄位（如 Gemini key）AES-256-GCM 加密金鑰：base64 編碼的 32 bytes
# 產生：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENC_KEY=
# 選用：Gemini API key 的 fallback（亦可改在 後台 ▸ 網站設定 貼上，加密存 DB）
GEMINI_API_KEY=
# Google 服務帳戶金鑰（base64 的 service account JSON），供 後台 ▸ 流量分析 讀 GA4/GSC。切勿外流。
GOOGLE_SERVICE_ACCOUNT_JSON=
